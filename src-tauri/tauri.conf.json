{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Masar",
  "version": "0.1.0",
  "identifier": "com.masar.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 500,
        "height": 350,
        "decorations": false,
        "resizable": false,
        "center": true,
        "transparent": false,
        "visible": true
      },
      {
        "title": "Masar",
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "devtools": true,
        "backgroundColor": "#090c18",
        "visible": false

      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
